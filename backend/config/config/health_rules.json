  "health_score_weights": {
    "calories": 10,
    "sugar": 20,
    "salt": 15,
    "saturated_fat": 15,
    "trans_fat": 15,
    "protein": 15,
    "fiber": 10,
    "additives": 15,
    "nova_group": 10
  },

  "health_score_bands": {
    "excellent": { "min": 85, "max": 100, "label": "Excellent", "color": "#1B873F" },
    "good": { "min": 65, "max": 84, "label": "Good", "color": "#66BB6A" },
    "moderate": { "min": 45, "max": 64, "label": "Moderate", "color": "#FDD835" },
    "poor": { "min": 25, "max": 44, "label": "Poor", "color": "#FB8C00" },
    "bad": { "min": 0, "max": 24, "label": "Bad", "color": "#E53935" }
  },

  "artificial_sweeteners": {
