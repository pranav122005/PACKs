  "high_risk_sweetener_syrups": {
    "hfcs": { "aliases": ["high fructose corn syrup", "high-fructose corn syrup", "corn syrup"], "risk_level": "high" },
    "invert_sugar_syrup": { "aliases": ["invert sugar", "invert syrup"], "risk_level": "moderate" }
  },

  "nova_classification": {
    "nova_1": {
      "label": "Unprocessed or minimally processed foods",
      "max_ingredient_count": 1,
      "description": "Single natural ingredient with no additives."
    },
    "nova_2": {
      "label": "Processed culinary ingredients",
      "max_ingredient_count": 2,
      "description": "Oils, butter, sugar, salt extracted from nova_1 foods or nature."
    },
    "nova_3": {
      "label": "Processed foods",
      "max_additive_count": 2,
      "description": "Nova_1/2 foods with added salt, sugar, oil, or a small number of preservatives."
    },
    "nova_4": {
      "label": "Ultra-processed food and drink products",
      "min_additive_count": 3,
      "description": "Formulations with 5+ ingredients including additives not used in home cooking (colours, flavours, sweeteners, emulsifiers, etc.)."
    }
  },

  "disease_thresholds": {
    "diabetes": { "sugar_high_g": 15, "sugar_moderate_g": 8, "fiber_protective_g": 5, "artificial_sweetener_caution": true },
    "hypertension": { "salt_high_g": 1.2, "salt_moderate_g": 0.6, "sodium_high_mg": 480, "sodium_moderate_mg": 240 },
    "heart_disease": { "saturated_fat_high_g": 5, "trans_fat_high_g": 0.2, "sodium_high_mg": 480 },
    "kidney_disease": { "sodium_high_mg": 400, "protein_high_g": 15, "potassium_caution": true, "phosphate_additive_caution": true },
    "pregnancy": { "additive_caution": true, "caffeine_caution": true, "unpasteurized_caution": true, "artificial_sweetener_caution": true },
    "children": { "sugar_high_g": 10, "artificial_colour_caution": true, "artificial_sweetener_caution": true, "caffeine_caution": true },
    "weight_loss": { "calories_high_kcal": 250, "sugar_high_g": 10, "fat_high_g": 15, "fiber_protective_g": 5 },
    "muscle_gain": { "protein_low_g": 8, "protein_excellent_g": 20, "sugar_caution_g": 20 },
    "pcos": { "sugar_high_g": 10, "refined_carb_caution": true, "trans_fat_high_g": 0.2 },
    "thyroid": { "soy_caution": true, "iodine_caution": true, "processed_food_caution": true }
  },

  "recommendation_settings": {
    "max_alternatives_returned": 5,
    "min_score_improvement": 10,
    "same_category_match": true,
    "gym_protein_target_g_per_meal": 20,
    "daily_calorie_reference_kcal": 2000,
    "daily_sugar_reference_g": 25,
    "daily_salt_reference_g": 5,
    "daily_saturated_fat_reference_g": 20,
    "daily_protein_reference_g": 50,
    "daily_fiber_reference_g": 30
  }
